# Token de la API DENUE (obtener en https://www.inegi.org.mx/app/api/denue/v1/tokenVerify.aspx)
DENUE_TOKEN=tu_token_aqui

# Modelo de Ollama a usar (qwen2.5:7b recomendado; llama3.2:3b como alternativa)
MODELO_IA=qwen2.5:7b

# URL del servidor Ollama
OLLAMA_URL=http://localhost:11434

# Ruta al catálogo de programas de apoyo
CATALOGO_APOYOS_PATH=backend/datos/catalogo_apoyos.json
